# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/

RUN pnpm install --frozen-lockfile --filter @dashboard/api...

COPY packages/shared packages/shared
COPY packages/api packages/api

RUN pnpm --filter @dashboard/shared build \
  && pnpm --filter @dashboard/api build

RUN pnpm --filter @dashboard/api deploy --prod --legacy /app/deploy

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

RUN groupadd --system dashboard \
  && useradd --system --gid dashboard --create-home dashboard

COPY --from=build --chown=dashboard:dashboard /app/deploy /app

USER dashboard
ENV NODE_ENV=production

EXPOSE 3000
CMD ["node", "dist/server.js"]

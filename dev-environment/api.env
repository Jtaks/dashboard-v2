# Environment for running @dashboard/api on the host against this compose stack.
# Paths are relative to packages/api (pnpm --filter @dashboard/api … cwd).
# Loaded automatically by `pnpm dev:environment`.

CONFIG_PATH=../../dev-environment/dashboard.yaml
DATABASE_PATH=../../dev-environment/data/dashboard.db
VAPID_KEYS_PATH=../../dev-environment/vapid.json
VAPID_SUBJECT=mailto:admin@localhost
DOCKER_PROXY_URL=http://127.0.0.1:2375
ALLOWED_ORIGIN=http://localhost:8080
AUTHELIA_LOGOUT_URL=http://localhost:8080/
PORT=3000
LOG_LEVEL=debug

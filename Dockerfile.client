# Static client image: nginx serves the SvelteKit adapter-static output with SPA fallback.
# Build: docker build -f Dockerfile.client -t dashboard-client .

FROM node:22-bookworm AS build

RUN corepack enable && corepack prepare pnpm@11.15.1 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY shared/package.json shared/tsconfig.json ./shared/
COPY client/package.json client/tsconfig.json client/svelte.config.js client/vite.config.ts ./client/
COPY client/project.inlang/settings.json ./client/project.inlang/
COPY client/messages ./client/messages/
COPY api/package.json ./api/

# Full install (scripts on): esbuild postinstall + client prepare (paraglide) need to run.
RUN pnpm install --frozen-lockfile --filter @dashboard/client...

COPY shared ./shared
COPY client ./client

RUN pnpm --filter @dashboard/client build

FROM nginx:1.27-alpine AS runtime

COPY deploy/nginx-client.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/client/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

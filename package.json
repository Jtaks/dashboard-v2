{
  "name": "dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:environment": "node scripts/dev-environment.mjs",
    "build": "pnpm --filter @dashboard/shared build && pnpm --filter @dashboard/api build && pnpm --filter @dashboard/client build",
    "test": "pnpm -r test",
    "check:docs": "node scripts/check-integrator-docs.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
